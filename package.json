{
  "name": "dietbridge-mobile-ui-port-audit",
  "version": "0.1.0",
  "private": true,
  "description": "DietBridge mobile-ui-port icin bagimsiz Expo audit harness'i (UI-only, backend yok).",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "audit:source": "node scripts/audit-source.js",
    "audit:doctor": "expo-doctor",
    "audit:android": "expo export --platform android --output-dir dist-audit/android",
    "audit:ios": "expo export --platform ios --output-dir dist-audit/ios",
    "audit": "npm run audit:source && npm run audit:doctor && npm run audit:android && npm run audit:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "expo": "~57.0.7",
    "expo-font": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "babel-preset-expo": "~57.0.3",
    "expo-doctor": "^1.20.1"
  }
}
